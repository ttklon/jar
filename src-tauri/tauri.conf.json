{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZShelper",
  "version": "0.1.0",
  "identifier": "app.zshelper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZShelper",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msix"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Локальный агент-оператор для Windows",
    "longDescription": "ZShelper слышит, видит экран и умеет управлять компьютером: файлы, документы, медиа, сеть, приложения. Работает локально, спрашивает подтверждение на опасном.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
