[
 {
  "id": "system-health",
  "title": "Как поживает компьютер",
  "summary": "Собирает картину целиком: сколько свободного места, что говорит SMART, кто грузит процессор, есть ли сеть и кто слушает порты. Только чтение — ничего не меняется.",
  "registry": "monitoring-triage|составить|отчёт о здоровье ПК",
  "risk": "read",
  "inputs": [],
  "steps": [
   {
    "tool": "storage-backup|проверить|свободное место",
    "note": "сколько осталось на дисках",
    "params": {}
   },
   {
    "tool": "storage-backup|проверить|SMART диска",
    "note": "здоровье накопителей",
    "params": {}
   },
   {
    "tool": "processes-services|показать|топ по нагрузке",
    "note": "кто ест процессор и память",
    "params": {}
   },
   {
    "tool": "network|проверить|подключение",
    "note": "есть ли интернет",
    "params": {}
   },
   {
    "tool": "network|проверить|открытые порты",
    "note": "кто слушает порты",
    "params": {}
   }
  ]
 },
 {
  "id": "folder-audit",
  "title": "Что в этой папке",
  "summary": "Считает объём папки, ищет файлы по маске и одинаковые файлы по хэшу. Ничего не удаляет — это разведка перед уборкой.",
  "registry": "files|проверить|размеры и место",
  "risk": "read",
  "inputs": [
   {
    "name": "folder",
    "label": "Папка",
    "placeholder": "C:\\Users\\Имя\\Downloads",
    "hint": "считает рекурсивно, включая вложенные папки",
    "required": true
   },
   {
    "name": "mask",
    "label": "Маска имени",
    "placeholder": "*.pdf",
    "hint": "например *.jpg или договор*",
    "required": true
   }
  ],
  "steps": [
   {
    "tool": "files|проверить|размеры и место",
    "note": "объём и самые частые расширения",
    "params": {
     "path": "$folder"
    }
   },
   {
    "tool": "files|найти|по имени",
    "note": "что подходит под маску",
    "params": {
     "path": "$folder",
     "query": "$mask"
    }
   },
   {
    "tool": "files|проверить|дубликаты по хэшу",
    "note": "одинаковые файлы внутри папки",
    "params": {
     "path": "$folder"
    }
   }
  ]
 },
 {
  "id": "free-space",
  "title": "Освободить место",
  "summary": "Сначала показывает, что занимает место и где дубликаты, и только в конце отправляет выбранную папку в корзину. Удаление требует отдельного подтверждения и всегда обратимо до очистки корзины.",
  "registry": "files|удалить|в корзину",
  "risk": "destructive",
  "inputs": [
   {
    "name": "folder",
    "label": "Где смотреть",
    "placeholder": "C:\\Users\\Имя\\Downloads",
    "hint": "эта папка только читается",
    "required": true
   },
   {
    "name": "trash",
    "label": "Что отправить в корзину",
    "placeholder": "C:\\Users\\Имя\\Downloads\\Старое",
    "hint": "полный путь; удаляется ровно эта папка, ничего другого",
    "required": true
   }
  ],
  "steps": [
   {
    "tool": "storage-backup|проверить|свободное место",
    "note": "с чего начинаем",
    "params": {}
   },
   {
    "tool": "files|проверить|размеры и место",
    "note": "сколько занимает папка",
    "params": {
     "path": "$folder"
    }
   },
   {
    "tool": "files|проверить|дубликаты по хэшу",
    "note": "что можно убрать без потерь",
    "params": {
     "path": "$folder"
    }
   },
   {
    "tool": "files|удалить|в корзину",
    "note": "единственный шаг, который меняет диск",
    "params": {
     "path": "$trash"
    }
   }
  ]
 },
 {
  "id": "new-folder",
  "title": "Создать папку проекта",
  "summary": "Создаёт папку вместе с недостающими родителями и сразу подтверждает результат: путь существует и внутри пока пусто.",
  "registry": "files|создать|папку",
  "risk": "write-local",
  "inputs": [
   {
    "name": "path",
    "label": "Полный путь",
    "placeholder": "C:\\Users\\Имя\\Documents\\Проект X",
    "hint": "родительские папки создадутся сами",
    "required": true
   }
  ],
  "steps": [
   {
    "tool": "files|создать|папку",
    "note": "создание вместе с родителями",
    "params": {
     "path": "$path"
    }
   },
   {
    "tool": "files|проверить|размеры и место",
    "note": "проверка, что папка новая и пустая",
    "params": {
     "path": "$path"
    }
   }
  ]
 },
 {
  "id": "network-check",
  "title": "Почему нет интернета",
  "summary": "Проверяет подключение и смотрит, какие программы слушают порты. Отвечает на вопрос «это провайдер или что-то локальное».",
  "registry": "network|проверить|подключение",
  "risk": "read",
  "inputs": [],
  "steps": [
   {
    "tool": "network|проверить|подключение",
    "note": "есть ли выход в сеть",
    "params": {}
   },
   {
    "tool": "network|проверить|открытые порты",
    "note": "что слушает локально",
    "params": {}
   }
  ]
 },
 {
  "id": "startup-audit",
  "title": "Что запускается само",
  "summary": "Показывает автозапуск и пятерых самых прожорливых по памяти — чтобы понять, из-за кого компьютер включается медленно. Только чтение.",
  "registry": "processes-services|проанализировать|автозапуск",
  "risk": "read",
  "inputs": [],
  "steps": [
   {
    "tool": "processes-services|проанализировать|автозапуск",
    "note": "кто стартует вместе с Windows",
    "params": {}
   },
   {
    "tool": "processes-services|показать|топ по нагрузке",
    "note": "кто сейчас занимает память",
    "params": {}
   }
  ]
 }
]
