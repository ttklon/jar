{
  "app": "REAPER",
  "exe": [
    "reaper.exe"
  ],
  "ui_stack": "win32",
  "version_seen": "7.x (2026-11)",
  "verified_at": "2026-11-08",
  "anchors": {
    "cli": {
      "by": "api",
      "value": "reaper.exe -new -nosplash <project.rpp> / ReaScript через reaper.exe -batch"
    },
    "reascript": {
      "by": "api",
      "value": "Lua/Python: reaper.Main_OnCommand, InsertMedia, SetMediaItemInfo"
    },
    "render": {
      "by": "cli",
      "value": "-renderproject <file.rpp>"
    },
    "actions_window": {
      "by": "hotkey",
      "value": "?"
    }
  },
  "operations": [
    {
      "name": "Собрать сессию из MIDI и аудио",
      "registry": "music-production|свести|дорожки",
      "steps": [
        "reascript:вставить дорожки из шаблона",
        "reascript:InsertMedia для MIDI/WAV",
        "выставить темп и сетку"
      ],
      "verify": [
        "число треков = плану",
        "длительность проекта = длине аранжировки",
        "сохранён .rpp"
      ],
      "risk": "write-local"
    },
    {
      "name": "Применить цепочку обработки на мастер",
      "registry": "music-production|мастерить|трек",
      "steps": [
        "reascript:добавить FX-цепочку (EQ → компрессор → лимитер)",
        "установить параметры"
      ],
      "verify": [
        "FX присутствуют в проекте",
        "после рендера true peak < -1 dBTP"
      ],
      "risk": "write-local",
      "notes": "REAPER — лучший выбор для программного мастеринга: всё управляется скриптом"
    },
    {
      "name": "Отрендерить мастер и стемы",
      "registry": "music-production|экспортировать|финальный мастер",
      "steps": [
        "cli:reaper.exe -renderproject <file.rpp>",
        "wait:до конца"
      ],
      "verify": [
        "WAV существует",
        "ffprobe: pcm_s24le 44.1/48 кГц",
        "число стемов = числу дорожек"
      ],
      "risk": "write-local",
      "timeouts_ms": 1800000
    },
    {
      "name": "Нормализовать громкость по стандарту",
      "registry": "audio|нормализовать|громкость",
      "steps": [
        "reascript:SWS/ReaScript loudness normalize",
        "проверить ebur128"
      ],
      "verify": [
        "LUFS -14 ±1",
        "true peak < -1 dBTP"
      ],
      "risk": "write-local"
    },
    {
      "name": "Сохранить проект с версией",
      "registry": "music-production|открыть|проект в DAW",
      "steps": [
        "reascript:Main_SaveProject",
        "копия в папку версий с датой"
      ],
      "verify": [
        ".rpp существует",
        "резервная копия отличается по хэшу при изменениях"
      ],
      "risk": "write-local"
    },
    {
      "name": "Импортировать MIDI-партию в проект",
      "registry": "music-production|импортировать|MIDI в проект",
      "steps": [
        "reascript:reaper.InsertMedia('<path.mid>', 0)",
        "назначить дорожке инструмент (VSTi или ReaSynth)",
        "проверить длину и число нот"
      ],
      "verify": [
        "в проекте появился айтем с MIDI-событиями",
        "число нот совпадает с исходным файлом (парсинг .mid)",
        "при воспроизведении уровень канала > −60 dB"
      ],
      "risk": "write-local",
      "notes": "InsertMedia вставляет на выбранную дорожку — сначала явно выбрать дорожку, иначе айтем уедет в случайное место"
    },
    {
      "name": "Проверить громкость и пики отрендеренного мастера",
      "registry": "music-production|проверить|громкость и пики",
      "steps": [
        "cli:ffmpeg -i master.wav -af ebur128=peak=true -f null -",
        "cli:ffmpeg -i master.wav -af astats=metadata=1 -f null -",
        "сравнить с целевыми значениями брифа"
      ],
      "verify": [
        "integrated LUFS получен числом",
        "true peak ≤ −1.0 dBTP",
        "клиппированных сэмплов 0",
        "значения записаны в отчёт о сдаче, а не только показаны"
      ],
      "risk": "read"
    },
    {
      "name": "Разделить трек на стемы и вернуть их в проект",
      "registry": "music-production|разделить|трек на стемы",
      "steps": [
        "cli:demucs -n htdemucs --two-stems=vocals <mix> (или 4 стема)",
        "проверить, что сумма стемов ≈ исходнику",
        "reascript: импорт стемов в отдельные дорожки"
      ],
      "verify": [
        "стемы созданы и не пустые",
        "сумма стемов минус исходник: остаточная энергия < 3 % (проверка вычитанием)",
        "стемы выровнены по нулю (нет сдвига фазы)"
      ],
      "risk": "write-local",
      "notes": "для сведения чужих стемов — только при наличии прав; для своих записей ограничений нет"
    },
    {
      "name": "Согласовать этап с пользователем",
      "registry": "music-production|согласовать|этап",
      "steps": [
        "отрендерить mp3-превью 60–90 с",
        "приложить 3–5 конкретных вопросов (темп, плотность, характер вокала)",
        "ждать ответа, проект не закрывать"
      ],
      "verify": [
        "превью существует и прослушивается",
        "вопросы конкретные, а не «как вам?»",
        "получен явный ответ (да/правки) — иначе этап не считается принятым"
      ],
      "risk": "read",
      "notes": "три обязательных чекпойнта: бит, текст, голос; дальше можно идти до конца автономно"
    }
  ]
}
