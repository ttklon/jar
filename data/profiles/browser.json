{
  "app": "Chrome / Edge / Yandex (Chromium)",
  "exe": [
    "chrome.exe",
    "msedge.exe",
    "browser.exe"
  ],
  "ui_stack": "web",
  "version_seen": "Chrome 131+ / Edge 131+",
  "verified_at": "2026-11-08",
  "anchors": {
    "new_tab": {
      "by": "hotkey",
      "value": "Ctrl+T"
    },
    "address": {
      "by": "hotkey",
      "value": "Ctrl+L"
    },
    "find": {
      "by": "hotkey",
      "value": "Ctrl+F"
    },
    "save_page": {
      "by": "hotkey",
      "value": "Ctrl+S"
    },
    "print": {
      "by": "hotkey",
      "value": "Ctrl+P"
    },
    "reader": {
      "by": "hotkey",
      "value": "F9 (режим чтения в части версий)"
    },
    "devtools": {
      "by": "hotkey",
      "value": "F12"
    }
  },
  "operations": [
    {
      "name": "Открыть URL и дождаться загрузки",
      "registry": "web|открыть|сайт",
      "steps": [
        "anchor:address",
        "type:URL",
        "Enter",
        "wait:networkidle≤10с"
      ],
      "verify": [
        "title не пустой",
        "нет экрана ошибки (OCR: 404/не удаётся)"
      ],
      "risk": "external",
      "on_fail": "повтор 2 раза, затем скриншот в Telegram"
    },
    {
      "name": "Найти текст на странице",
      "registry": "web|найти|текст на странице",
      "steps": [
        "anchor:find",
        "type:строка",
        "Enter"
      ],
      "verify": [
        "в панели поиска число совпадений > 0"
      ],
      "risk": "read"
    },
    {
      "name": "Снять страницу в PDF",
      "registry": "web|сохранить|страницу в PDF",
      "steps": [
        "anchor:print",
        "выбрать «Сохранить как PDF»",
        "type:путь",
        "Enter"
      ],
      "verify": [
        "PDF существует",
        "pypdf: число страниц > 0",
        "текст извлекается"
      ],
      "risk": "write-local"
    },
    {
      "name": "Скачать файл по ссылке",
      "registry": "web|скачать|файл по ссылке",
      "steps": [
        "клик по ссылке загрузки",
        "wait:файл в папке загрузок"
      ],
      "verify": [
        "файл появился и его размер стабилен 2 с",
        "расширение соответствует ожиданию"
      ],
      "risk": "write-local",
      "notes": "проверять MIME/размер, не запускать .exe из загрузок"
    },
    {
      "name": "Заполнить форму и отправить",
      "registry": "web|заполнить|форму",
      "steps": [
        "click:поле",
        "type:значение (по одному)",
        "verify:все поля заполнены",
        "click:отправить"
      ],
      "verify": [
        "появилось сообщение об успехе",
        "данные совпали с профилем пользователя"
      ],
      "risk": "external",
      "on_fail": "не отправлять повторно; показать человеку скриншот",
      "notes": "персональные данные — только из локального профиля, с подтверждением"
    },
    {
      "name": "Войти в сервис (сохранённая сессия)",
      "registry": "web|войти|в аккаунт",
      "steps": [
        "открыть URL",
        "если форма логина → использовать сохранённый профиль браузера"
      ],
      "verify": [
        "виден аватар/имя пользователя, нет формы пароля"
      ],
      "risk": "identity",
      "notes": "пароли не читаем и не вводим из хранилища модели; только persistent profile"
    },
    {
      "name": "Собрать таблицу данных со страницы (парсинг)",
      "registry": "web|извлечь|данные в таблицу",
      "steps": [
        "reader/DevTools: получить DOM",
        "извлечь таблицу в JSON",
        "нормализовать"
      ],
      "verify": [
        "число строк = числу на странице",
        "нет пустых ключевых полей"
      ],
      "risk": "read",
      "notes": "уважать robots.txt и rate-limit"
    },
    {
      "name": "Заблокировать рекламу и трекеры для агентских сессий",
      "registry": "web|настроить|профиль браузера",
      "steps": [
        "запустить отдельный профиль браузера с расширением/фильтрами"
      ],
      "verify": [
        "на тестовой странице 0 рекламных блоков"
      ],
      "risk": "write-local"
    }
  ]
}
